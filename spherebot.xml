<mujoco model="spherebot_v1">
  <compiler angle="radian"/>
  <option timestep="0.001" gravity="0 0 -9.81" cone="pyramidal"/>
  <default>
    <geom friction="0.4 0.001 0.0005"/>
  </default>
  <worldbody>
    <light pos="2 -3 4" dir="-0.4 0.6 -1" diffuse="0.9 0.9 0.9"/>
    <light pos="-2 3 4" dir="0.4 -0.6 -1" diffuse="0.5 0.5 0.5"/>
    <geom name="floor" type="plane" size="30 30 0.1" condim="6" rgba="0.75 0.65 0.5 1"/>
    <body name="shell" pos="0 0 0.203">
      <freejoint name="shell_free"/>
      <inertial mass="1.5535426999413815" pos="0 0 0" diaginertia="0.04267996074792293 0.04267996074792293 0.04267996074792293"/>
      <geom name="shellg" type="sphere" size="0.203" condim="6" rgba="0.55 0.75 0.95 0.30"/>
      <geom type="sphere" size="0.015" pos="0.2030 0.0000 0" rgba="0.9 0.1 0.1 1" contype="0" conaffinity="0"/>
<geom type="sphere" size="0.015" pos="0.1435 0.1435 0" rgba="0.9 0.1 0.1 1" contype="0" conaffinity="0"/>
<geom type="sphere" size="0.015" pos="0.0000 0.2030 0" rgba="0.9 0.1 0.1 1" contype="0" conaffinity="0"/>
<geom type="sphere" size="0.015" pos="-0.1435 0.1435 0" rgba="0.9 0.1 0.1 1" contype="0" conaffinity="0"/>
<geom type="sphere" size="0.015" pos="-0.2030 0.0000 0" rgba="0.9 0.1 0.1 1" contype="0" conaffinity="0"/>
<geom type="sphere" size="0.015" pos="-0.1435 -0.1435 0" rgba="0.9 0.1 0.1 1" contype="0" conaffinity="0"/>
<geom type="sphere" size="0.015" pos="-0.0000 -0.2030 0" rgba="0.9 0.1 0.1 1" contype="0" conaffinity="0"/>
<geom type="sphere" size="0.015" pos="0.1435 -0.1435 0" rgba="0.9 0.1 0.1 1" contype="0" conaffinity="0"/>

      <site name="shell_ctr" pos="0 0 0" size="0.005"/>
      <!-- chassis: hangs from diameter axle (bearing hinge y), elastomer-isolated (slide z) -->
      <body name="chassis" pos="0 0 0">
        <inertial mass="0.985" pos="0 0 -0.02" diaginertia="0.006 0.006 0.003"/>
        <joint name="iso_z" type="slide" axis="0 0 1" stiffness="50000.0" damping="185.0"
               range="-0.012 0.012" limited="true"/>
        <joint name="bearing_y" type="hinge" axis="0 1 0" frictionloss="0.002"/>
        <geom type="box" size="0.05 0.05 0.02" pos="0 0 -0.02" rgba="0.3 0.3 0.3 1" contype="0" conaffinity="0"/>
        <geom type="capsule" size="0.008" fromto="0 0 0 0 0 0.12" rgba="0.4 0.4 0.45 1" contype="0" conaffinity="0"/>
        <geom name="camera" type="box" size="0.015 0.015 0.01" pos="0 0 0.125" rgba="0.1 0.9 0.2 1" contype="0" conaffinity="0"/>
        <camera name="campov" pos="0 0 0.125" xyaxes="1 0 0 0 0 1" fovy="62"/>
        <light name="headlight" pos="0 0 0.12" dir="1 0 -0.15" directional="false" diffuse="0.8 0.8 0.75" specular="0.2 0.2 0.2"/>
        <site name="cam_site" pos="0 0 0.125" size="0.005"/>
        <!-- pendulum: battery + ballast, lateral-lean hinge x for steering -->
        <body name="pendulum" pos="0 0 0">
          <inertial mass="2.8" pos="0 0 -0.1557" diaginertia="0.0695 0.0695 0.0055"/>
          <joint name="steer_x" type="hinge" axis="1 0 0" frictionloss="0.002"/>
          <geom type="cylinder" size="0.06 0.004" pos="0 0 -0.15" rgba="0.5 0.5 0.55 1" contype="0" conaffinity="0"/>
          <geom type="box" size="0.055 0.03 0.028" pos="0 0 -0.09" rgba="0.8 0.6 0.1 1" contype="0" conaffinity="0"/>
          <geom type="capsule" size="0.006" fromto="0 0 0 0 0 -0.12" rgba="0.4 0.4 0.45 1" contype="0" conaffinity="0"/>
        </body>
      </body>
    </body>

    <!-- ===== terrain park: surfaces (priority=1 -> their friction wins vs floor), hills, steps, curb ===== -->
    <geom name="pad_grass" group="1"  type="box" size="2 2 0.010" pos="-6 4 0.010" condim="6" priority="1" friction="1.2 0.05 0.010"  rgba="0.30 0.48 0.22 1"/>
    <geom name="pad_gravel" group="1" type="box" size="2 2 0.015" pos="6 4 0.015"  condim="6" priority="1" friction="1.6 0.08 0.020"  rgba="0.55 0.50 0.42 1"/>
    <geom name="pad_slick" group="1"  type="box" size="2 2 0.008" pos="-6 -5 0.008" condim="6" priority="1" friction="0.15 0.0005 0.0001" rgba="0.24 0.33 0.46 1"/>
    <geom name="hill" group="1" type="ellipsoid" size="1.8 1.8 0.45" pos="6 -4 -0.10" rgba="0.34 0.50 0.26 1"/>
    <geom name="ramp" group="1" type="box" size="1.5 1.0 0.3" pos="2.5 7 -0.083" euler="0 -0.13 0" rgba="0.60 0.60 0.62 1"/>
    <geom name="step_0" group="1" type="box" size="0.175 0.6 0.035" pos="10.000 0 0.035" rgba="0.62 0.62 0.64 1"/>
    <geom name="step_1" group="1" type="box" size="0.175 0.6 0.070" pos="10.350 0 0.070" rgba="0.58 0.58 0.60 1"/>
    <geom name="step_2" group="1" type="box" size="0.175 0.6 0.105" pos="10.700 0 0.105" rgba="0.62 0.62 0.64 1"/>
    <geom name="step_3" group="1" type="box" size="0.175 0.6 0.140" pos="11.050 0 0.140" rgba="0.58 0.58 0.60 1"/>
    <geom name="curb" group="1" type="box" size="0.75 0.15 0.06" pos="3 -8 0.06" rgba="0.65 0.65 0.66 1"/>
    <!-- real-world objects (group 1: lidar hazards) -->
    <geom name="bench_leg_l" group="1" type="box" size="0.05 0.20 0.20" pos="-3.5 8 0.20" rgba="0.35 0.22 0.12 1"/>
    <geom name="bench_leg_r" group="1" type="box" size="0.05 0.20 0.20" pos="-2.5 8 0.20" rgba="0.35 0.22 0.12 1"/>
    <geom name="bench_seat" group="1" type="box" size="0.65 0.225 0.035" pos="-3 8 0.425" rgba="0.48 0.30 0.16 1"/>
    <geom name="lamp_pole" group="1" type="cylinder" size="0.05 1.15" pos="5 9 1.15" rgba="0.15 0.16 0.18 1"/>
    <geom name="lamp_head" group="1" type="box" size="0.16 0.16 0.09" pos="5 9 2.35" rgba="0.9 0.85 0.6 1"/>
    <geom name="planter_a" group="1" type="box" size="0.40 0.40 0.18" pos="-8 -1 0.18" rgba="0.45 0.25 0.15 1"/>
    <geom name="planter_b" group="1" type="box" size="0.40 0.40 0.18" pos="-8 -3 0.18" rgba="0.45 0.25 0.15 1"/>
    <!-- pedestrians: mocap capsules, same trick as the validated campus sim -->
    <body name="ped_0" mocap="true" pos="0 0 0"><geom name="pedg_0" group="1" type="capsule" size="0.17 0.5" pos="0 0 0.85" rgba="0.20 0.25 0.70 1"/></body>
    <body name="ped_1" mocap="true" pos="0 0 0"><geom name="pedg_1" group="1" type="capsule" size="0.17 0.5" pos="0 0 0.85" rgba="0.70 0.25 0.20 1"/></body>
    <body name="ped_2" mocap="true" pos="0 0 0"><geom name="pedg_2" group="1" type="capsule" size="0.17 0.5" pos="0 0 0.85" rgba="0.20 0.55 0.30 1"/></body>
    <body name="ped_3" mocap="true" pos="0 0 0"><geom name="pedg_3" group="1" type="capsule" size="0.17 0.5" pos="0 0 0.85" rgba="0.65 0.55 0.20 1"/></body>
  </worldbody>
  <actuator>
    <motor name="drive" joint="bearing_y" ctrllimited="true" ctrlrange="-2.6477955 2.6477955"/>
    <motor name="steer" joint="steer_x" ctrllimited="true" ctrlrange="-2.6477955 2.6477955"/>
  </actuator>
</mujoco>
